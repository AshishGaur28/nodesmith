  "extensions": {
    "concurrency": {
      "threads": 2
    },
    "lifecycle": {
      "auto_activate": false,
      "auto_configure": false,
      "enabled": true,
      "on_error_strategy": "Reset",
      "transitions": {
        "on_activate_timeout_sec": 0.5,
        "on_configure_timeout_sec": 2.0
      }
    },
    "realtime": {
      "callback_groups": [
        {
          "deadline_us": 1000,
          "name": "control_loop_group",
          "on_deadline_miss": "error_transition",
          "type": "MutuallyExclusive"
        }
      ],
      "cpu_affinity": [
        2,
        3
      ],
      "enabled": true,
      "executor": {
        "type": "MultiThreadedExecutor"
      },
      "memory_lock": true,
      "policy": "SCHED_FIFO",
      "priority": 80,
      "stack_size_bytes": 1048576
    },
    "security": {
      "enabled": true,
      "enclave": "/perception/camera/vision_ctrl_node",
      "encryption": {
        "allow_unencrypted_metadata": false
      },
      "key_store_path": "/etc/ros/sros2/keystore",
      "permissions": {
        "subscribe": [
          {
            "allow": true,
            "topic": "/clock"
          }
        ]
      },
      "security_mode": "enforce"
    },
    "shared_memory": {
      "enabled": true,
      "fallback_to_heap": true,
      "max_loaned_messages": 8,
      "middleware_backend": "rmw_default",
      "segment_size_bytes": 16777216
    },
    "simulation": {
      "enabled": true,
      "enabled_in_production": false,
      "fault_injection": [
        {
          "delay_ms": 50,
          "enabled_in_production": false,
          "probability": 0.05,
          "seed": 1337,
          "target": "steering_pub",
          "type": "latency_spike"
        }
      ],
      "step_mode": "lockstep",
      "use_sim_time": true
    },
    "telemetry": {
