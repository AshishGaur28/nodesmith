        {
          "iterations": 10000,
          "name": "control_bench",
          "pipeline": "control_loop",
          "warmup_iterations": 1000
        }
      ],
      "enabled": true,
      "jitter_tolerance_us": 50,
      "latency_budget_us": 500,
      "on_budget_exceeded": "raise_diagnostic",
      "tracing_provider": "lttng"
    }
